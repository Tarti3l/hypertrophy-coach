{
  "name": "hypertrophy-coach",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "pnpm --filter @hypertrophy/mobile start",
